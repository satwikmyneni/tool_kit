FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-value
# Local development origin. Set BASE_URL=https://www.tools4all.in on Render.
BASE_URL=http://127.0.0.1:5000
PRODUCT_TIER=FREE
ADS_ENABLED=false
ANALYTICS_PROVIDER=

# Search visibility. Use the single preferred public HTTPS origin in production.
# Set SEO_INDEXING_ENABLED=false on preview and staging deployments.
SEO_INDEXING_ENABLED=true
# Optional accurate W3C date/datetime for significant site-wide content releases.
SEO_LASTMOD=
# Paste only the verification token values, not complete meta tags.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Upload and processing limits (bytes unless otherwise noted)
MAX_CONTENT_LENGTH=52428800
MAX_PDF_FILES=20
MAX_PDF_FILE_BYTES=20971520
MAX_PDF_PAGES=500
PDF_PREVIEW_DPI=48
PDF_PREVIEW_MAX_WIDTH=180
PDF_PREVIEW_MAX_HEIGHT=260
PDF_PREVIEW_MAX_PAGES=60
MAX_CONVERSION_PAGES=100
MAX_CONVERSION_TOTAL_PIXELS=80000000
MAX_DOCUMENT_FILE_BYTES=20971520
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=60
# Optional absolute path to soffice/libreoffice. Leave blank to auto-detect.
LIBREOFFICE_PATH=
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_FILES=20
MAX_IMAGE_PIXELS=20000000
MAX_IMAGE_EDGE=2000
MAX_GIF_FRAMES=24
MAX_GIF_TOTAL_PIXELS=24000000
MAX_QR_CHARS=2000
MAX_BARCODE_CHARS=80
MAX_TTS_CHARS=5000
TTS_TIMEOUT_SECONDS=30

# Background removal
REMBG_MODEL=u2netp

# Rate limiting. Use a shared backend such as Redis for multi-worker production.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_QR=30 per minute
RATELIMIT_BARCODE=30 per minute
RATELIMIT_PDF=10 per minute
RATELIMIT_PDF_PREVIEW=30 per minute
RATELIMIT_IMAGE=5 per minute
RATELIMIT_GIF=10 per minute
RATELIMIT_TTS=10 per minute
